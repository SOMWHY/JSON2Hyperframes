*.bak
*.tmp
*.tgz

# TypeScript 增量构建缓存（开启 incremental 后会生成）
*.tsbuildinfo

# 测试覆盖率
coverage/
.nyc_output/

# OS 临时文件
.DS_Store
Thumbs.db
ehthumbs.db

# 日志
*.log
